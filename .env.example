# 로컬 개발용 환경 변수 설정 (보안상 .gitignore에 추가됨)
# 주의: 이 파일은 예시이므로 실제 비밀번호로 수정하여 .env 파일로 저장하세요.

DB_ROOT_PASSWORD=root_password
DB_USERNAME=quiz_user
DB_PASSWORD=quiz_password

REDIS_HOST=localhost
REDIS_PORT=6379

# 최소 32자 이상의 랜덤 문자열을 사용하세요.
JWT_SECRET=your_very_long_and_secure_random_secret_key_at_least_32_chars
